<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 피드 반응 칩 (👏 🔥 💪) -->
    <style name="ReactionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_reaction_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 커뮤니티 탭 (피드 · 월간 리그 · 레이드) -->
    <style name="SegmentTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_segment_tab</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/segment_tab_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
