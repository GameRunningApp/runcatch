<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC">

    <!-- 상단 타이틀 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="03_러닝측정중"
        android:textSize="14sp"
        android:textColor="#9AA6BD"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 지도 영역 (지금은 placeholder, 나중에 지도 연결) -->
    <View
        android:id="@+id/mapPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#DCE6FA"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.55" />

    <!-- 거리 -->
    <TextView
        android:id="@+id/tvDistanceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="거리"
        android:textSize="13sp"
        android:textColor="#667085"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/mapPlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tvTimeLabel"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <TextView
        android:id="@+id/tvDistanceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00 km"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1E2A47"
        app:layout_constraintTop_toBottomOf="@id/tvDistanceLabel"
        app:layout_constraintStart_toStartOf="@id/tvDistanceLabel"
        app:layout_constraintEnd_toEndOf="@id/tvDistanceLabel" />

    <!-- 시간 -->
    <TextView
        android:id="@+id/tvTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="시간"
        android:textSize="13sp"
        android:textColor="#667085"
        app:layout_constraintTop_toTopOf="@id/tvDistanceLabel"
        app:layout_constraintStart_toEndOf="@id/tvDistanceLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1E2A47"
        app:layout_constraintTop_toBottomOf="@id/tvTimeLabel"
        app:layout_constraintStart_toStartOf="@id/tvTimeLabel"
        app:layout_constraintEnd_toEndOf="@id/tvTimeLabel" />

    <!-- 페이스 -->
    <TextView
        android:id="@+id/tvPaceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="페이스"
        android:textSize="13sp"
        android:textColor="#667085"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvDistanceText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0'00&quot;/km"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1E2A47"
        app:layout_constraintTop_toBottomOf="@id/tvPaceLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 버튼 가운데 기준선 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- 일시정지 버튼 (왼쪽, 러닝 중일 때 보임) -->
    <Button
        android:id="@+id/btnPause"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="⏸ 일시정지"
        android:textColor="#FFFFFF"
        android:backgroundTint="#9AA6BD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineButtons"
        app:layout_constraintTop_toBottomOf="@id/tvPace"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="24dp" />

    <!-- 계속 버튼 (왼쪽, 일시정지 중일 때만 보임 - tvPace 기준으로 직접 고정) -->
    <Button
        android:id="@+id/btnResume"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="▶ 계속"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5B9BFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineButtons"
        app:layout_constraintTop_toBottomOf="@id/tvPace"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- 종료 버튼 (오른쪽, 항상 보임 - tvPace 기준으로 직접 고정) -->
    <Button
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="■ 종료"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5B9BFF"
        app:layout_constraintStart_toEndOf="@id/guidelineButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPace"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>