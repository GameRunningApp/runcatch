<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA"
    android:padding="0dp">

    <!-- 1. 지도 영역 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#DCE9F8">

        <!-- 실제 지도 -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/resultMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 상단 영역 -->
        <TextView
            android:id="@+id/resultTopArea"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:background="#E7F0FC" />

    </FrameLayout>

    <!-- 2. 러닝 기록 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- 거리 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E6F0FF"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="거리"
                android:textColor="#8795A8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/resultDistanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 Km"
                android:textColor="#26334B"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- 시간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E6F0FF"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="시간"
                android:textColor="#8795A8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/resultTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#26334B"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- 페이스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E6F0FF"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="페이스"
                android:textColor="#8795A8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/resultPaceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00'00'00' /km"
                android:textColor="#26334B"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- 획득 경험치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E6F0FF"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="획득 경험치"
                android:textColor="#8795A8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/resultXPText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 XP"
                android:textColor="#26334B"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- 대표 캐릭터 레벨 진행 -->
        <LinearLayout
            android:id="@+id/resultLevelBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:background="#E6F0FF"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/resultLevelCharacterText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐥 캐릭터  Lv.1"
                    android:textColor="#26334B"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <!-- 레벨이 올랐을 때만 보임 -->
                <TextView
                    android:id="@+id/resultLevelUpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_primary_button"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="LEVEL UP!"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/resultLevelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_next_character" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- 경험치 내역 (러닝 완료 · 거리 · 연속 러닝) -->
                <TextView
                    android:id="@+id/resultExpDetailText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="러닝 완료 +20"
                    android:textColor="#8795A8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/resultLevelExpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 50 XP"
                    android:textColor="#8795A8"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 3. 하단 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#5B96FF"
            android:text="다음"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
