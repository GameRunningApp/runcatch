<?xml version="1.0" encoding="utf-8"?>
<!-- 월간 리그 순위 한 줄 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rankRow"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <!-- 1~3위는 메달, 4위부터 숫자 -->
    <TextView
        android:id="@+id/rankNumberText"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/nav_inactive"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rankAvatarText"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="🐰"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/rankNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="닉네임"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rankLevelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_level_pill"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="LV.1"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 연속 러닝 일수 (내 줄에만 표시) -->
    <TextView
        android:id="@+id/rankStreakText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="🔥5일"
        android:textColor="#FFF07A3A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/rankDistanceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0 km"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
